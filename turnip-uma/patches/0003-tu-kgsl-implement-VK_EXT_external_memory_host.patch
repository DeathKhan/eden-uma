 tu_bo_finish(struct tu_device *dev, struct tu_bo *bo);
 
diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 44af0c22201..a3e5c7fd33c 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -434,6 +434,69 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+/* VK_EXT_external_memory_host: KGSL pins the pages of [host_ptr, host_ptr+size)
+ * and maps them into the GPU address space. The import is IO-coherent and
+ * write-back cached, so the CPU keeps using its own mapping with no cache
+ * maintenance. The CPU mapping stays owned by the application.
+ */
+static VkResult
+kgsl_bo_init_host_ptr(struct tu_device *dev,
+                      struct tu_bo **out_bo,
+                      void *host_ptr,
+                      uint64_t size)
+{
+   struct kgsl_gpuobj_import_useraddr import_useraddr = {
+      .virtaddr = (uintptr_t) host_ptr,
+   };
+   /* For KGSL_USER_MEM_TYPE_ADDR the kernel takes the length from priv_len. */
+   struct kgsl_gpuobj_import req = {
+      .priv = (uintptr_t) &import_useraddr,
+      .priv_len = size,
+      .flags = KGSL_MEMFLAGS_IOCOHERENT |
+               (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT),
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+
+   int ret = safe_ioctl(dev->physical_device->local_fd,
+                        IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   if (ret)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import host pointer (%s)\n", strerror(errno));
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_INFO, &info_req);
+   if (ret) {
+      struct kgsl_gpumem_free_id free_req = { .id = req.id };
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to get host pointer import info (%s)\n", strerror(errno));
+   }
+
+   struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = info_req.size,
+      .iova = info_req.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, info_req.size, "hostptr"),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .never_unmap = true,
+      .host_ptr = true,
+   };
+
+   tu_dump_bo_init(dev, bo);
+
+   *out_bo = bo;
+
+   return VK_SUCCESS;
+}
+
 static int
 kgsl_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -481,7 +544,7 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
-   if (bo->map) {
+   if (bo->map && !bo->host_ptr) {
       TU_RMV(bo_unmap, dev, bo);
       munmap(bo->map, bo->size);
    }
@@ -1795,6 +1858,7 @@ static const struct tu_knl kgsl_knl_funcs = {
       .bo_init = kgsl_bo_init,
       .bo_init_dmabuf = kgsl_bo_init_dmabuf,
       .bo_export_dmabuf = kgsl_bo_export_dmabuf,
+      .bo_init_host_ptr = kgsl_bo_init_host_ptr,
       .bo_map = kgsl_bo_map,
       .bo_allow_dump = kgsl_bo_allow_dump,
       .bo_finish = kgsl_bo_finish,
@@ -1922,6 +1986,9 @@ tu_knl_kgsl_load(struct tu_instance *instance, int fd)
       fd, KGSL_MEMFLAGS_IOCOHERENT |
              (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT));
 
+   /* Host pointer imports are only exposed IO-coherent (see kgsl_bo_init_host_ptr). */
+   device->has_host_ptr_import = device->has_cached_coherent_memory;
+
    device->has_sparse = kgsl_is_virtual_bo_supported(fd);
    device->has_sparse_prr = device->has_sparse;
    device->has_lazy_bos = device->has_sparse;
