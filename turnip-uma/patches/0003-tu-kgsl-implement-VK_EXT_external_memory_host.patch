    /* Index for device local, host-coherent, host-cached memory.
     * Only set to positive index when overwriting device-local, uncached memory
     */
diff --git a/src/freedreno/vulkan/tu_knl.cc b/src/freedreno/vulkan/tu_knl.cc
index d1435cd317f..aec10154c07 100644
--- a/src/freedreno/vulkan/tu_knl.cc
+++ b/src/freedreno/vulkan/tu_knl.cc
@@ -114,6 +114,20 @@ tu_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+VkResult
+tu_bo_init_host_ptr(struct tu_device *dev, struct tu_bo **bo,
+                    void *host_ptr, uint64_t size)
+{
+   if (!dev->instance->knl->bo_init_host_ptr)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   VkResult result = dev->instance->knl->bo_init_host_ptr(dev, bo, host_ptr, size);
+   if (result != VK_SUCCESS)
+      return result;
+   if (!(*bo)->unique_id)
+      (*bo)->unique_id = (*bo)->gem_handle;
+   return VK_SUCCESS;
+}
