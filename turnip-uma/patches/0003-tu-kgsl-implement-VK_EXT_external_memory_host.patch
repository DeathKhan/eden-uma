@@ -227,6 +231,10 @@ tu_bo_init_dmabuf(struct tu_device *dev,
 int
 tu_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo);
 
+VkResult
+tu_bo_init_host_ptr(struct tu_device *dev, struct tu_bo **bo,
