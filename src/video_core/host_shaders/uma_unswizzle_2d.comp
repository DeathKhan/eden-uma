// UMA texture upload: unswizzles one mip level (all array layers) of a block-linear 2D image
// straight from guest RAM (a host-aliased window of it) into a linear buffer, which is then
// copied into the image. Blocks of 1 and 2 bytes are packed into 32-bit words so the shader
// needs no 8/16-bit storage; output rows are padded to whole words.

#version 450

layout(push_constant) uniform PushConstants {
    uvec3 blocks_dim;          // blocks per row, rows, layers
    uint bytes_per_block_log2;
    uint src_offset;           // byte offset of this level's layer 0 in the input binding
    uint layer_stride;         // bytes between layers in guest memory
    uint block_size;           // bytes per row of GOB blocks
    uint x_shift;
    uint block_height;
    uint block_height_mask;
    uint dst_offset_words;     // start of this level in the output
    uint dst_row_words;
    uint dst_layer_words;
};

layout(binding = 0, std430) readonly buffer InputBuffer {
    uint src[];
};
layout(binding = 1, std430) writeonly buffer OutputBuffer {
    uint dst[];
};

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

const uint GOB_SIZE_SHIFT = 9; // 64 x 8 bytes

uint SwizzleTable(uint pos) {
    const uint t[8] = uint[](
        0x12100200, 0x13110301, 0x16140604, 0x17150705,
        0x1a180a08, 0x1b190b09, 0x1e1c0e0c, 0x1f1d0f0d
    );
    const uint i = pos >> 4;
    const uint h = (t[i / 4] >> ((i % 4) * 8)) & 0xff;
    return (h << 4) | (pos & 0xf);
}

uint SwizzledOffset(uint x_bytes, uint y, uint layer) {
    const uint block_y = y >> 3;
    uint offset = src_offset + layer * layer_stride;
    offset += (block_y >> block_height) * block_size;
    offset += (block_y & block_height_mask) << GOB_SIZE_SHIFT;
    offset += (x_bytes >> 6) << x_shift;
    offset += SwizzleTable((y & 7) * 64 + (x_bytes & 63));
    return offset;
}

void main() {
    const uvec3 id = gl_GlobalInvocationID;
    if (id.y >= blocks_dim.y || id.z >= blocks_dim.z) {
        return;
    }
    const uint row = dst_offset_words + id.z * dst_layer_words + id.y * dst_row_words;
    if (bytes_per_block_log2 >= 2) {
        // One block per invocation: 1, 2 or 4 words, contiguous within a GOB.
        if (id.x >= blocks_dim.x) {
            return;
        }
        const uint words = 1u << (bytes_per_block_log2 - 2);
        const uint src_word = SwizzledOffset(id.x << bytes_per_block_log2, id.y, id.z) >> 2;
        for (uint w = 0; w < words; ++w) {
            dst[row + id.x * words + w] = src[src_word + w];
        }
        return;
    }
    // One output word per invocation, packing 4 (1-byte) or 2 (2-byte) blocks.
    if (id.x >= dst_row_words) {
        return;
    }
    const uint per_word = 4u >> bytes_per_block_log2;
    const uint bits = 8u << bytes_per_block_log2;
    uint word = 0;
    for (uint i = 0; i < per_word; ++i) {
        const uint bx = id.x * per_word + i;
        if (bx >= blocks_dim.x) {
            break;
        }
        const uint src_byte = SwizzledOffset(bx << bytes_per_block_log2, id.y, id.z);
        const uint value = bitfieldExtract(src[src_byte >> 2], int((src_byte & 3u) * 8u), int(bits));
        word |= value << (i * bits);
    }
    dst[row + id.x] = word;
}
